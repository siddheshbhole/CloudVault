APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Credentials (Put your Project URL and Secret/Service Key here)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key
SUPABASE_BUCKET=cloudvault-blocks

# Encryption Master Key (Base64-encoded 32 bytes for AES-256)
# Example generated with python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CLOUDVAULT_MASTER_KEY_B64=zK9zV7aG4s8PqW1X2y3Z4a5B6c7D8e9F0g1H2i3J4k5=

# File handling limits
MAX_UPLOAD_SIZE_BYTES=104857600
CHUNK_SIZE_BYTES=1048576
